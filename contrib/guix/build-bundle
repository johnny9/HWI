export LC_ALL=C
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repository_root="$(cd "${script_dir}/../.." && pwd)"
cd "${repository_root}"

if [[ "${HWI_GUIX_ALLOW_DIRTY:-0}" != 1 ]] &&
   [[ -n "$(git status --porcelain --untracked-files=normal)" ]]; then
    echo "The HWI worktree must be clean for a reproducible build" >&2
    exit 1
fi

export SOURCE_DATE_EPOCH="${SOURCE_DATE_EPOCH:-$(git show -s --format=%ct HEAD)}"
export HWI_TARGET="${HWI_TARGET:-x86_64-linux-gnu}"

case "${HWI_TARGET}" in
    x86_64-linux-gnu) guix_system=x86_64-linux ;;
    arm-linux-gnueabihf) guix_system=armhf-linux ;;
    aarch64-linux-gnu) guix_system=aarch64-linux ;;
    riscv64-linux-gnu) guix_system=riscv64-linux ;;
    *)
        echo "Unsupported Guix HWI target: ${HWI_TARGET}" >&2
        exit 1
        ;;
esac

output_dir="${HWI_GUIX_OUTPUT_DIR:-${repository_root}/dist/guix}"
mkdir -p "${output_dir}"

read -r -a extra_flags <<< "${HWI_GUIX_BUILD_FLAGS:-}"
store_output="$({
    guix time-machine -C contrib/guix/channels.scm -- \
        build --no-grafts --system="${guix_system}" "${extra_flags[@]}" \
        -f contrib/guix/hwi-bundle.scm
} | tail -n 1)"

mapfile -t archives < <(find "${store_output}" -maxdepth 1 -type f \
    -name 'hwi-*.tar.gz' -print)
if [[ "${#archives[@]}" != 1 ]]; then
    echo "Expected one bundle archive in ${store_output}" >&2
    exit 1
fi

archive_name="$(basename "${archives[0]}")"
install -m 0644 "${archives[0]}" "${output_dir}/${archive_name}"
(
    cd "${output_dir}"
    sha256sum "${archive_name}" > "${archive_name}.sha256"
)

echo "${output_dir}/${archive_name}"
